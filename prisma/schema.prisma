generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id       String @id
    email    String @unique
    password String
    profile  Json
    files    File[]
}

model File {
    id          String   @id
    fileName    String
    fileOwnerId     String @map("ownerId")
    mimeType    String
    sizeInBytes Int
    uploadedAt  DateTime @default(now())

    fileOwner User? @relation(fields: [fileOwnerId], references: [id], onDelete: Cascade)
}

model Session {
    id        String   @id
    sid       String   @unique
    data      String
    expiresAt DateTime
}
